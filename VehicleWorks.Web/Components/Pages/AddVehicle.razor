@page "/vehicles/add"
@rendermode InteractiveServer
@using VehicleWorks.Web.Models
@using VehicleWorks.Web.Services

@inject VehicleService VehicleService
@inject ManufacturerService ManufacturerService
@inject CategoryService CategoryService

<PageTitle>Add Vehicle</PageTitle>

<h1>Add Vehicle</h1>

<EditForm Model="vehicle"
          OnValidSubmit="HandleSubmit"
          FormName="add-vehicle"
          class="vehicle-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Owner Name</label>
        <InputText @bind-Value="vehicle.OwnerName" />
    </div>

    <div>
        <label>Manufacturer</label>
        <InputSelect @bind-Value="vehicle.ManufacturerId">
            <option value="">Select manufacturer</option>

            @foreach (var manufacturer in manufacturers)
            {
                <option value="@manufacturer.Id">
                    @manufacturer.Name
                </option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Year of Manufacture</label>
        <InputNumber @bind-Value="vehicle.YearOfManufacture" />
    </div>

    <div>
        <label>Weight (kg)</label>
        <InputNumber @bind-Value="vehicle.WeightKg" step="0.01" />
    </div>

    <button type="submit">Add Vehicle</button>
</EditForm>

@code {
    private Vehicle vehicle = new();
    private List<Manufacturer> manufacturers = [];

    protected override async Task OnInitializedAsync()
    {
        manufacturers = await ManufacturerService.GetAllAsync();
    }

    private async Task HandleSubmit()
    {
        await VehicleService.AddAsync(vehicle);
    }
}